generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  READER
  AUTHOR
  ADMIN
  MODERATOR
}

enum ProjectStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
  BLOCKED
}

enum ProjectVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum ProjectType {
  HANDBOOK
  GUIDE
  COURSE
  INSTRUCTION
  LECTURE
}

enum ProjectLanguage {
  EN
  ES
  FR
  DE
  IT
  PT
  RU
  ZH
}

enum ProjectModerationAction {
  SUBMITTED
  PUBLISHED
  UNPUBLISHED
  REJECTED
  BLOCKED
  ARCHIVED
  UNBLOCKED
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique @db.VarChar(255)
  username              String?                @unique @db.VarChar(50)
  password              String                 @db.VarChar(255)
  firstName             String?                @db.VarChar(100)
  lastName              String?                @db.VarChar(100)
  avatarUrl             String?                @db.Text
  role                  UserRole               @default(READER)
  isActive              Boolean                @default(true)
  sessions              AuthSession[]
  projects              Project[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  projectModerationLogs ProjectModerationLog[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique @db.VarChar(255)
  isRevoked        Boolean   @default(false)
  expiresAt        DateTime
  lastUsedAt       DateTime?
  userAgent        String?   @db.Text
  ip               String?   @db.VarChar(64)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRevoked])
  @@index([expiresAt])
  @@index([userId, isRevoked])
  @@map("auth_sessions")
}

model Project {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String? @db.Text
  coverUrl    String? @db.VarChar(500)

  type       ProjectType       @default(GUIDE)
  status     ProjectStatus     @default(DRAFT)
  visibility ProjectVisibility @default(PRIVATE)

  language ProjectLanguage @default(EN)
  ownerId  String

  projectModerationLogs ProjectModerationLog[]

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([status, visibility])
  @@index([type])
  @@map("projects")
}

model ProjectModerationLog {
  id String @id @default(cuid())

  projectId String
  actorId   String

  action ProjectModerationAction

  reason String? @db.Text

  comment String? @db.Text

  previousStatus ProjectStatus?
  nextStatus     ProjectStatus

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("project_moderation_logs")
}
